---
import Base from '../layouts/Base.astro';
---
<Base title="Page Not Found" description="The page you were looking for could not be found." noindex>
  <section class="section">
    <div class="container-x max-w-xl text-center">
      <p class="eyebrow">404</p>
      <h1 class="mt-3 text-4xl font-extrabold">You weren't supposed to find this place…</h1>
      <p class="mt-4 text-lg text-slate-600">The page you're looking for doesn't exist or has moved.</p>
      <div class="mt-8 flex justify-center gap-3"><a href="/" class="btn-primary">Go home</a><a href="/contact/" class="btn-outline">Contact us</a></div>
    </div>
  </section>
</Base>
