---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base title="Thank You" description="Thanks for contacting FAJTech." noindex>
  <section class="section">
    <div class="container-x max-w-xl text-center">
      <span class="mx-auto inline-flex h-16 w-16 items-center justify-center rounded-full bg-brand-100 text-brand-600"><Icon name="check" class="h-8 w-8" /></span>
      <h1 class="mt-6 text-4xl font-extrabold">Message sent — thank you!</h1>
      <p class="mt-4 text-lg text-slate-600">Our team will get back to you within one business day.</p>
      <a href="/" class="btn-primary mt-8">Back to home</a>
    </div>
  </section>
</Base>
