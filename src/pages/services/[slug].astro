---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import CtaBand from '../../components/CtaBand.astro';
import { services, type Service } from '../../data/services';
import { site, zoho } from '../../config/site';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { service: s } }));
}
const { service } = Astro.props as { service: Service };
const others = services.filter((s) => s.slug !== service.slug).slice(0, 3);
const bookHref = zoho.bookingsUrl || '/contact/';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.title,
  description: service.intro,
  provider: { '@id': `${site.url}/#business` },
  areaServed: [{ '@type': 'City', name: 'Calgary' }, { '@type': 'Country', name: 'Canada' }],
};
---
<Base title={`${service.title} in Calgary`} description={`${service.short} FAJTech serves Calgary and businesses across Canada.`} schema={schema}>
  <PageHero eyebrow="Services" title={service.title} text={service.intro}>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href={bookHref} class="btn-primary px-6 py-3.5 text-base">Book a Free Consultation</a>
      <a href="/services/" class="btn-ghost px-6 py-3.5 text-base">All services</a>
    </div>
  </PageHero>

  <section class="section">
    <div class="container-x">
      <h2 class="text-3xl font-extrabold">What's included</h2>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {service.features.map((f) => (
          <div class="rounded-2xl border border-slate-200 p-6">
            <span class="inline-flex rounded-lg bg-brand-50 p-2 text-brand-600"><Icon name="check" class="h-5 w-5" /></span>
            <h3 class="mt-4 text-lg font-bold">{f.title}</h3>
            <p class="mt-2 text-slate-600">{f.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-slate-50">
    <div class="container-x grid items-center gap-10 lg:grid-cols-2">
      <div>
        <p class="eyebrow">The results</p>
        <h2 class="mt-3 text-3xl font-extrabold">What you can expect</h2>
        <p class="mt-4 text-lg text-slate-600">Built to keep your business stable, secure and productive.</p>
      </div>
      <ul class="grid gap-4 sm:grid-cols-2">
        {service.outcomes.map((o) => (
          <li class="flex items-center gap-3 rounded-xl border border-slate-200 bg-white p-5 font-semibold text-ink-900">
            <Icon name="check" class="h-5 w-5 shrink-0 text-brand-500" />{o}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container-x">
      <h2 class="text-2xl font-extrabold">Related services</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {others.map((s) => (
          <a href={`/services/${s.slug}/`} class="card group">
            <span class="text-brand-600"><Icon name={s.icon} /></span>
            <h3 class="mt-3 font-bold">{s.title}</h3>
            <p class="mt-1 text-sm text-slate-600">{s.short}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
  <CtaBand title={`Talk to us about ${service.title.toLowerCase()}`} />
</Base>
