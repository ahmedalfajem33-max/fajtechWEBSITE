---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
const values = [
  { icon: 'clock', title: 'Responsive', text: 'We answer quickly and keep you informed until the job is done.' },
  { icon: 'shield', title: 'Reliable', text: 'Proactive monitoring and maintenance mean fewer problems in the first place.' },
  { icon: 'handshake', title: 'Accountable', text: 'We stand behind all of our work for every client. No excuses, 100% of the time.' },
  { icon: 'chat', title: 'Plain language', text: 'No jargon. We explain options clearly so you can make good decisions.' },
];
---
<Base title="About FAJTech" description="FAJTech is a Calgary-based managed IT services and technology consulting company helping Canadian businesses stay secure, efficient and future-ready.">
  <PageHero eyebrow="About us" title="Smart IT solutions for Canadian businesses" text="We simplify technology so you can focus on growth." />
  <section class="section">
    <div class="container-x grid gap-12 lg:grid-cols-2">
      <div>
        <p class="eyebrow">Our story</p>
        <h2 class="mt-3 text-3xl font-extrabold">An IT partner, not just a help desk</h2>
      </div>
      <div class="space-y-4 text-lg leading-relaxed text-slate-600">
        <p>FAJTech provides reliable IT services and smart technology solutions that help businesses stay secure, efficient and future-ready. From managed IT and cybersecurity to cloud and automation, we take care of the technology so our clients can focus on their work.</p>
        <p>Based in Calgary, Alberta, we support businesses locally on site and across Canada remotely. We work as an extension of your team — whether we run all of your IT or support the people you already have.</p>
        <p>Every client has a dedicated client success manager who ensures personalised support, proactive communication and IT solutions tailored to your business.</p>
      </div>
    </div>
  </section>
  <section class="section bg-slate-50">
    <div class="container-x">
      <p class="eyebrow">Our values</p>
      <h2 class="mt-3 text-3xl font-extrabold">The principles that guide our work</h2>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {values.map((v) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-6">
            <span class="text-brand-600"><Icon name={v.icon} /></span>
            <h3 class="mt-4 text-lg font-bold">{v.title}</h3>
            <p class="mt-2 text-slate-600">{v.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  <CtaBand title="Want to work with FAJTech?" />
</Base>
