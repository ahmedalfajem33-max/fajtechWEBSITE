---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ContactForm from '../components/ContactForm.astro';
import { site, zoho } from '../config/site';

const expect = [
  { icon: 'clock', title: '30 minutes, no cost', text: 'A relaxed conversation by video, phone or in person in Calgary.' },
  { icon: 'shield', title: 'Quick risk check', text: 'We look at your current setup and point out the biggest security and reliability risks.' },
  { icon: 'compass', title: 'Clear next steps', text: 'You leave with practical recommendations — whether or not you work with us.' },
  { icon: 'handshake', title: 'No pressure', text: 'No hard sell and no obligation. Just honest advice from IT experts.' },
];
---
<Base title="Book a Free IT Consultation" description="Book a free, no-obligation 30-minute IT consultation with FAJTech. Pick a day and time that works for you — video, phone or in person in Calgary.">
  <section class="relative overflow-hidden bg-ink-900 text-white">
    <div class="grid-bg absolute inset-0" aria-hidden="true"></div>
    <div class="absolute -left-32 top-0 h-80 w-80 rounded-full bg-brand-500/20 blur-3xl" aria-hidden="true"></div>
    <div class="container-x relative py-14 sm:py-16">
      <p class="eyebrow text-brand-300">Free consultation</p>
      <h1 class="mt-3 max-w-3xl text-4xl font-extrabold text-white sm:text-5xl">Book a free IT consultation</h1>
      <p class="mt-5 max-w-2xl text-lg text-slate-300">Pick a day and time that suits you. Talk to a FAJTech IT expert about your technology, security and goals — free and with no obligation.</p>
    </div>
  </section>

  <section class="section pt-12 sm:pt-16">
    <div class="container-x grid gap-10 lg:grid-cols-[1fr_1.6fr]">
      <aside class="order-2 lg:order-1">
        <h2 class="text-2xl font-extrabold">What to expect</h2>
        <ul class="mt-6 space-y-6">
          {expect.map((e) => (
            <li class="flex gap-4">
              <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-brand-600"><Icon name={e.icon} class="h-5 w-5" /></span>
              <span>
                <span class="block font-bold text-ink-900">{e.title}</span>
                <span class="mt-1 block text-slate-600">{e.text}</span>
              </span>
            </li>
          ))}
        </ul>
        <div class="mt-10 rounded-2xl bg-slate-50 p-6 text-sm text-slate-600">
          <p class="font-semibold text-ink-900">Prefer to reach us directly?</p>
          <p class="mt-2"><a href={`mailto:${site.email}`} class="text-brand-600 hover:underline">{site.email}</a></p>
          {site.phone && <p class="mt-1"><a href={`tel:${site.phone.replace(/[^+\d]/g, '')}`} class="text-brand-600 hover:underline">{site.phone}</a></p>}
          <p class="mt-1">{site.hours}</p>
        </div>
      </aside>

      <div class="order-1 lg:order-2">
        {zoho.bookingsUrl ? (
          <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
            <iframe
              src={zoho.bookingsUrl}
              title="Book a consultation with FAJTech"
              class="block h-[1000px] w-full border-0 sm:h-[820px]"
              loading="lazy"
              allow="payment"
            ></iframe>
          </div>
        ) : (
          <div class="rounded-2xl border border-slate-200 p-6 shadow-sm sm:p-8">
            <h2 class="text-2xl font-extrabold">Choose your preferred time</h2>
            <p class="mt-2 mb-8 text-slate-600">Tell us when suits you and we'll confirm your appointment by email within one business day.</p>
            <ContactForm booking />
          </div>
        )}
      </div>
    </div>
  </section>
</Base>
