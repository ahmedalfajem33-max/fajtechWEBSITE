---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ContactForm from '../components/ContactForm.astro';
import { site, zoho } from '../config/site';

const expect = [
  { icon: 'clock', title: '30 minutes, no cost', text: 'A relaxed conversation by video, phone or in person in Calgary.' },
  { icon: 'shield', title: 'Quick risk check', text: 'We look at your current setup and point out the biggest security and reliability risks.' },
  { icon: 'compass', title: 'Clear next steps', text: 'You leave with practical recommendations — whether or not you work with us.' },
  { icon: 'handshake', title: 'No pressure', text: 'No hard sell and no obligation. Just honest advice from IT experts.' },
];
---
<Base title="Book a Free IT Consultation" description="Book a free, no-obligation 30-minute IT consultation with FAJTech. Pick a day and time that works for you — video, phone or in person in Calgary.">
  <!-- Hero (GAM Tech-style: large title, curved bottom edge) -->
  <section class="relative overflow-hidden bg-ink-900 text-white">
    <div class="grid-bg absolute inset-0" aria-hidden="true"></div>
    <div class="absolute -left-32 -top-20 h-96 w-96 rounded-full bg-brand-500/25 blur-3xl" aria-hidden="true"></div>
    <div class="absolute -right-20 top-10 h-80 w-80 rounded-full bg-sky-500/10 blur-3xl" aria-hidden="true"></div>
    <div class="container-x relative pt-16 pb-40 sm:pt-20 sm:pb-48">
      <p class="eyebrow text-brand-300">Free · 30 minutes · No obligation</p>
      <h1 class="mt-4 max-w-3xl text-4xl font-extrabold leading-tight text-white sm:text-6xl">Book a Free IT Consultation Today</h1>
      <p class="mt-5 max-w-2xl text-lg text-slate-300">Discover how FAJTech can make your business more secure, reliable and efficient. Pick a day and time that suits you.</p>
    </div>
    <svg class="absolute bottom-0 left-0 block h-16 w-full text-white sm:h-24" viewBox="0 0 1440 100" preserveAspectRatio="none" aria-hidden="true">
      <path fill="currentColor" d="M0,60 C360,110 720,0 1080,30 C1260,45 1380,70 1440,60 L1440,100 L0,100 Z" />
    </svg>
  </section>

  <!-- Calendar card, pulled up over the hero -->
  <section class="relative z-10 -mt-32 pb-16 sm:-mt-36">
    <div class="container-x">
      <div class="mx-auto max-w-5xl overflow-hidden rounded-2xl bg-white shadow-2xl ring-1 ring-slate-200">
        {zoho.bookingsUrl ? (
          <iframe
            src={zoho.bookingsUrl}
            title="Book a consultation with FAJTech"
            class="block h-[1000px] w-full border-0 sm:h-[760px]"
            loading="lazy"
          ></iframe>
        ) : (
          <div class="p-6 sm:p-10">
            <h2 class="text-2xl font-extrabold">Choose your preferred time</h2>
            <p class="mt-2 mb-8 text-slate-600">Tell us when suits you and we'll confirm your appointment by email within one business day.</p>
            <ContactForm booking />
          </div>
        )}
      </div>
      <p class="mt-5 text-center text-sm text-slate-500">
        Prefer to reach us directly? Email <a href={`mailto:${site.email}`} class="font-semibold text-brand-600 hover:underline">{site.email}</a>{site.phone && <> or call <a href={`tel:${site.phone.replace(/[^+\d]/g, '')}`} class="font-semibold text-brand-600 hover:underline">{site.phone}</a></>} · {site.support}
      </p>
    </div>
  </section>

  <!-- What to expect -->
  <section class="bg-brand-500 text-white">
    <div class="container-x py-14 sm:py-16">
      <h2 class="text-center text-3xl font-extrabold text-white sm:text-4xl">What to expect from your consultation</h2>
      <div class="mx-auto mt-3 h-1 w-14 rounded bg-white/70"></div>
      <ul class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {expect.map((e) => (
          <li class="text-center">
            <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-white/15 text-white"><Icon name={e.icon} class="h-6 w-6" /></span>
            <span class="mt-4 block text-lg font-bold">{e.title}</span>
            <span class="mt-1 block text-brand-50/90">{e.text}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
