---
import Icon from './Icon.astro';
import { services } from '../data/services';
import { site } from '../config/site';
const year = new Date().getFullYear();
const location = site.showStreetAddress
  ? `${site.address.street}, ${site.address.city}, ${site.address.regionName}`
  : `${site.address.city}, ${site.address.regionName}, Canada`;
---
<footer class="bg-ink-950 text-slate-400">
  <div class="container-x grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <a href="/" class="flex items-center gap-2.5 text-white">
        <img src="/favicon.svg" alt="" width="32" height="32" class="h-8 w-8 rounded-lg bg-white p-1" />
        <span class="text-lg font-extrabold">FAJ<span class="text-brand-400">Tech</span></span>
      </a>
      <p class="mt-4 text-sm leading-relaxed">Managed IT, cybersecurity and cloud services for Canadian businesses, with 24/7/365 support. Proudly based in Calgary, Alberta.</p>
      {site.social.linkedin && (
        <a href={site.social.linkedin} class="mt-4 inline-flex rounded-full bg-white/5 p-2 hover:bg-brand-500 hover:text-white" aria-label="FAJTech on LinkedIn"><Icon name="linkedin" class="h-4 w-4" /></a>
      )}
    </div>
    <div>
      <h2 class="text-sm font-bold uppercase tracking-wider text-white">Services</h2>
      <ul class="mt-4 space-y-2 text-sm">
        {services.slice(0, 6).map((s) => <li><a href={`/services/${s.slug}/`} class="hover:text-brand-300">{s.title}</a></li>)}
      </ul>
    </div>
    <div>
      <h2 class="text-sm font-bold uppercase tracking-wider text-white">Company</h2>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a href="/about/" class="hover:text-brand-300">About FAJTech</a></li>
        <li><a href="/industries/" class="hover:text-brand-300">Industries</a></li>
        <li><a href="/services/" class="hover:text-brand-300">All services</a></li>
        <li><a href="/contact/" class="hover:text-brand-300">Contact</a></li>
        <li><a href="/privacy/" class="hover:text-brand-300">Privacy policy</a></li>
      </ul>
    </div>
    <div>
      <h2 class="text-sm font-bold uppercase tracking-wider text-white">Get in touch</h2>
      <ul class="mt-4 space-y-3 text-sm">
        <li class="flex gap-2.5"><Icon name="mail" class="mt-0.5 h-4 w-4 shrink-0 text-brand-400" /><a href={`mailto:${site.email}`} class="hover:text-brand-300">{site.email}</a></li>
        {site.phone && <li class="flex gap-2.5"><Icon name="phone" class="mt-0.5 h-4 w-4 shrink-0 text-brand-400" /><a href={`tel:${site.phone.replace(/[^+\d]/g, '')}`} class="hover:text-brand-300">{site.phone}</a></li>}
        <li class="flex gap-2.5"><Icon name="pin" class="mt-0.5 h-4 w-4 shrink-0 text-brand-400" />{location}</li>
        <li class="flex gap-2.5"><Icon name="clock" class="mt-0.5 h-4 w-4 shrink-0 text-brand-400" /><span><span class="block font-semibold text-white">{site.support}</span>{site.hours}</span></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="container-x flex flex-col gap-2 py-6 text-xs sm:flex-row sm:justify-between">
      <p>© {year} {site.legalName}. All rights reserved.</p>
      <p>Proudly Canadian · Calgary, Alberta</p>
    </div>
  </div>
</footer>
