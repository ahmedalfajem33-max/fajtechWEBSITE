---
import { partnerBadges } from '../data/partners';
interface Props { homepage?: boolean; tone?: 'light' | 'card' }
const { homepage = false, tone = 'light' } = Astro.props;
const badges = partnerBadges({ homepage });
---
{badges.length > 0 && (
  <ul class:list={['flex flex-wrap items-center justify-center gap-x-10 gap-y-6', tone === 'card' && 'gap-6']}>
    {badges.map((b) => (
      <li class:list={[tone === 'card' && 'flex h-28 w-52 items-center justify-center rounded-2xl border border-slate-200 bg-white p-5']}>
        <img src={b.src} alt={b.program} title={b.program} loading="lazy" decoding="async" class:list={[tone === 'card' ? 'max-h-full max-w-full object-contain' : 'h-12 w-auto max-w-[180px] object-contain sm:h-14']} />
      </li>
    ))}
  </ul>
)}
