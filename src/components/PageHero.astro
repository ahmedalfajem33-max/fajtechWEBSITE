---
interface Props { eyebrow?: string; title: string; text?: string }
const { eyebrow, title, text } = Astro.props;
---
<section class="relative overflow-hidden bg-ink-900 text-white">
  <div class="grid-bg absolute inset-0" aria-hidden="true"></div>
  <div class="absolute -left-32 top-0 h-80 w-80 rounded-full bg-brand-500/20 blur-3xl" aria-hidden="true"></div>
  <div class="container-x relative py-16 sm:py-20">
    {eyebrow && <p class="eyebrow text-brand-300">{eyebrow}</p>}
    <h1 class="mt-3 max-w-3xl text-4xl font-extrabold text-white sm:text-5xl">{title}</h1>
    {text && <p class="mt-5 max-w-2xl text-lg text-slate-300">{text}</p>}
    <slot />
  </div>
</section>
