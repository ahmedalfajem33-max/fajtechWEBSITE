---
import Icon from './Icon.astro';
import { services } from '../data/services';
import { industries } from '../data/industries';
import { site } from '../config/site';
const path = Astro.url.pathname;
const nav = [
  { href: '/about/', label: 'About' },
  { href: '/resources/', label: 'Resources' },
  { href: '/free-it-assessment/', label: 'Free Assessment' },
  { href: '/contact/', label: 'Contact' },
];
const bookHref = '/book-a-consultation/';
const isActive = (href: string) => path.startsWith(href);
---
<div class="bg-brand-600 text-white">
  <div class="container-x flex items-center justify-center gap-2 py-1.5 text-center text-xs font-medium sm:text-sm">
    <Icon name="clock" class="h-4 w-4 shrink-0" />
    <span><strong>24/7/365 IT support</strong><span class="hidden sm:inline"> &amp; monitoring</span> — <a href="#chat" data-open-chat class="font-bold underline-offset-2 hover:underline">Live chat 24/7</a><span class="hidden md:inline"> · Call <a href={`tel:${site.phone.replace(/[^+\d]/g, '')}`} class="font-bold underline-offset-2 hover:underline">{site.phone}</a> (8 am–7 pm MT) · <a href="/support/" class="underline-offset-2 hover:underline">Client support</a></span></span>
  </div>
</div>
<header class="sticky top-0 z-50 border-b border-white/10 bg-ink-900/95 text-white backdrop-blur supports-[backdrop-filter]:bg-ink-900/85">
  <div class="container-x flex h-16 items-center justify-between gap-4 lg:h-20">
    <a href="/" class="flex shrink-0 items-center gap-2.5" aria-label={`${site.name} home`}>
      <img src="/favicon.svg" alt="" width="36" height="36" class="h-9 w-9 rounded-lg bg-white p-1" />
      <span class="text-xl font-extrabold tracking-tight">FAJ<span class="text-brand-400">Tech</span></span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Main">
      <div class="group relative">
        <a href="/services/" class:list={['flex items-center gap-1 rounded-lg px-3 py-2 text-sm font-medium hover:text-brand-300', isActive('/services') && 'text-brand-300']}>
          Services <Icon name="chevron" class="h-4 w-4 transition group-hover:rotate-180" />
        </a>
        <div class="invisible absolute left-1/2 top-full w-[560px] -translate-x-1/2 pt-3 opacity-0 transition group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100">
          <div class="grid grid-cols-2 gap-1 rounded-2xl border border-slate-200 bg-white p-3 text-slate-700 shadow-2xl">
            {services.map((s) => (
              <a href={`/services/${s.slug}/`} class="flex gap-3 rounded-xl p-3 hover:bg-brand-50">
                <span class="mt-0.5 text-brand-600"><Icon name={s.icon} class="h-5 w-5" /></span>
                <span>
                  <span class="block text-sm font-semibold text-ink-900">{s.title}</span>
                  <span class="mt-0.5 block text-xs leading-snug text-slate-500">{s.short}</span>
                </span>
              </a>
            ))}
          </div>
        </div>
      </div>
      <div class="group/ind relative">
        <a href="/industries/" class:list={['flex items-center gap-1 rounded-lg px-3 py-2 text-sm font-medium hover:text-brand-300', isActive('/industries') && 'text-brand-300']}>
          Industries <Icon name="chevron" class="h-4 w-4 transition group-hover/ind:rotate-180" />
        </a>
        <div class="invisible absolute left-1/2 top-full w-[640px] -translate-x-1/2 pt-3 opacity-0 transition group-focus-within/ind:visible group-focus-within/ind:opacity-100 group-hover/ind:visible group-hover/ind:opacity-100">
          <div class="rounded-2xl border border-slate-200 bg-white p-3 text-slate-700 shadow-2xl">
            <div class="grid grid-cols-2 gap-1">
              {industries.map((i) => (
                <a href={`/industries/${i.slug}/`} class="flex items-center gap-3 rounded-xl px-3 py-2.5 hover:bg-brand-50">
                  <span class="text-brand-600"><Icon name={i.icon} class="h-5 w-5" /></span>
                  <span class="text-sm font-semibold text-ink-900">{i.title}</span>
                </a>
              ))}
            </div>
            <a href="/industries/" class="mt-2 flex items-center justify-center gap-1.5 rounded-xl bg-slate-50 py-2.5 text-sm font-semibold text-brand-700 hover:bg-brand-50">All industries <Icon name="arrow" class="h-4 w-4" /></a>
          </div>
        </div>
      </div>
      {nav.map((n) => (
        <a href={n.href} class:list={['whitespace-nowrap rounded-lg px-3 py-2 text-sm font-medium hover:text-brand-300', isActive(n.href) && 'text-brand-300']}>{n.label}</a>
      ))}
    </nav>

    <div class="hidden items-center gap-4 lg:flex">
      <a href="/support/" class="hidden whitespace-nowrap text-sm font-semibold text-slate-300 hover:text-white 2xl:inline">Get Support</a>
      {site.phone && (
        <a href={`tel:${site.phone.replace(/[^+\d]/g, '')}`} class="hidden items-center gap-2 whitespace-nowrap text-sm font-semibold hover:text-brand-300 2xl:flex">
          <Icon name="phone" class="h-4 w-4" />{site.phone}
        </a>
      )}
      <a href={bookHref} class="btn-primary whitespace-nowrap">Book a Free Consultation</a>
    </div>

    <button id="menu-btn" type="button" class="rounded-lg p-2 hover:bg-white/10 lg:hidden" aria-controls="mobile-menu" aria-expanded="false" aria-label="Open menu">
      <Icon name="menu" />
    </button>
  </div>

  <div id="mobile-menu" class="hidden max-h-[calc(100vh-4rem)] overflow-y-auto border-t border-white/10 lg:hidden">
    <nav class="container-x flex flex-col gap-1 py-4" aria-label="Mobile">
      <details class="group/m">
        <summary class="flex cursor-pointer list-none items-center justify-between rounded-lg px-3 py-2.5 font-semibold hover:bg-white/10 [&::-webkit-details-marker]:hidden">Services <Icon name="chevron" class="h-5 w-5 transition group-open/m:rotate-180" /></summary>
        <a href="/services/" class="block rounded-lg px-3 py-2 pl-6 text-sm font-semibold text-brand-300 hover:bg-white/10">All services</a>
        {services.map((s) => <a href={`/services/${s.slug}/`} class="block rounded-lg px-3 py-2 pl-6 text-sm text-slate-300 hover:bg-white/10">{s.title}</a>)}
      </details>
      <details class="group/m2">
        <summary class="flex cursor-pointer list-none items-center justify-between rounded-lg px-3 py-2.5 font-semibold hover:bg-white/10 [&::-webkit-details-marker]:hidden">Industries <Icon name="chevron" class="h-5 w-5 transition group-open/m2:rotate-180" /></summary>
        <a href="/industries/" class="block rounded-lg px-3 py-2 pl-6 text-sm font-semibold text-brand-300 hover:bg-white/10">All industries</a>
        {industries.map((i) => <a href={`/industries/${i.slug}/`} class="block rounded-lg px-3 py-2 pl-6 text-sm text-slate-300 hover:bg-white/10">{i.title}</a>)}
      </details>
      {nav.map((n) => <a href={n.href} class="rounded-lg px-3 py-2.5 font-semibold hover:bg-white/10">{n.label}</a>)}
      <a href="/support/" class="rounded-lg px-3 py-2.5 font-semibold hover:bg-white/10">Get Support (clients)</a>
      <a href={bookHref} class="btn-primary mt-3">Book a Free Consultation</a>
      {site.phone && <a href={`tel:${site.phone.replace(/[^+\d]/g, '')}`} class="btn-ghost mt-2">Call {site.phone}</a>}
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-btn')!;
  const menu = document.getElementById('mobile-menu')!;
  btn.addEventListener('click', () => {
    const open = menu.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });
</script>
