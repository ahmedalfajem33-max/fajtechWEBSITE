---
import { site } from '../config/site';
interface Props { title?: string; text?: string }
const {
  title = 'Ready for IT that just works?',
  text = 'Book a free, no-obligation IT assessment. We will review your systems and security and give you a clear plan — no pressure, no jargon.',
} = Astro.props;
const bookHref = '/book-a-consultation/';
---
<section class="relative overflow-hidden bg-ink-900 text-white">
  <div class="grid-bg absolute inset-0 opacity-60" aria-hidden="true"></div>
  <div class="absolute -right-24 -top-24 h-72 w-72 rounded-full bg-brand-500/30 blur-3xl" aria-hidden="true"></div>
  <div class="container-x relative flex flex-col items-start gap-8 py-16 lg:flex-row lg:items-center lg:justify-between">
    <div class="max-w-2xl">
      <h2 class="text-3xl font-extrabold text-white sm:text-4xl">{title}</h2>
      <p class="mt-4 text-lg text-slate-300">{text}</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <a href={bookHref} class="btn-primary px-6 py-3.5 text-base">Book a Free Assessment</a>
      {site.phone
        ? <a href={`tel:${site.phone.replace(/[^+\d]/g, '')}`} class="btn-ghost px-6 py-3.5 text-base">Call {site.phone}</a>
        : <a href={`mailto:${site.email}`} class="btn-ghost px-6 py-3.5 text-base">Email us</a>}
    </div>
  </div>
</section>
