---
import ContactForm from './ContactForm.astro';
import { site } from '../config/site';
// Time zones offered to customers. Each label gets its current local time added in the browser.
const zoneGroups: [string, [string, string][]][] = [
  ['Canada', [
    ['America/St_Johns', 'Newfoundland Time — St. John\'s'],
    ['America/Halifax', 'Atlantic Time — Halifax, Moncton, Charlottetown'],
    ['America/Toronto', 'Eastern Time — Toronto, Ottawa, Montréal, Québec City'],
    ['America/Atikokan', 'Eastern Standard Time (no DST) — Atikokan, Southampton Island'],
    ['America/Winnipeg', 'Central Time — Winnipeg, Thunder Bay (west)'],
    ['America/Regina', 'Saskatchewan — Regina, Saskatoon'],
    ['America/Edmonton', 'Alberta — Calgary, Edmonton, Red Deer'],
    ['America/Cambridge_Bay', 'Mountain Time — Yellowknife, Cambridge Bay'],
    ['America/Dawson_Creek', 'Northeast BC — Dawson Creek, Fort St. John'],
    ['America/Creston', 'Creston, BC'],
    ['America/Whitehorse', 'Yukon — Whitehorse, Dawson City'],
    ['America/Vancouver', 'Pacific Time — Vancouver, Victoria, Kelowna'],
  ]],
  ['United States', [
    ['America/New_York', 'Eastern Time — New York, Washington DC, Atlanta, Miami'],
    ['America/Detroit', 'Eastern Time — Detroit'],
    ['America/Chicago', 'Central Time — Chicago, Dallas, Houston'],
    ['America/Denver', 'Mountain Time — Denver, Salt Lake City'],
    ['America/Boise', 'Mountain Time — Boise'],
    ['America/Phoenix', 'Arizona — Phoenix (no DST)'],
    ['America/Los_Angeles', 'Pacific Time — Los Angeles, Seattle, San Francisco, Las Vegas'],
    ['America/Anchorage', 'Alaska — Anchorage, Juneau'],
    ['America/Adak', 'Hawaii–Aleutian — Adak'],
    ['Pacific/Honolulu', 'Hawaii — Honolulu'],
    ['America/Puerto_Rico', 'Atlantic Time — Puerto Rico, US Virgin Islands'],
    ['Pacific/Guam', 'Chamorro Time — Guam'],
  ]],
  ['Other', [
    ['Asia/Riyadh', 'Saudi Arabia — Riyadh, Jeddah'],
    ['Asia/Dubai', 'UAE — Dubai, Abu Dhabi'],
    ['Africa/Cairo', 'Egypt — Cairo'],
    ['Europe/London', 'United Kingdom — London'],
  ]],
];
---
<div id="bk" class="scroll-mt-32 overflow-hidden rounded-2xl bg-white shadow-2xl ring-1 ring-slate-200">
  <!-- Step 1: pick a time -->
  <div id="bk-step1" class="grid lg:grid-cols-[1fr_1.05fr]">
    <div class="bg-brand-600 p-6 text-white sm:p-8">
      <div class="flex flex-col items-center text-center">
        <span class="flex h-16 w-16 items-center justify-center rounded-full bg-white text-xl font-extrabold text-brand-700">AA</span>
        <p class="mt-3 text-lg font-semibold">Meet with <span id="bk-consultant">Ahmed Alfajem</span></p>
        <p class="text-sm text-brand-50">Free IT Consultation · 30 min</p>
      </div>
      <div class="mt-6 flex items-center justify-center gap-4">
        <button type="button" id="bk-prev" class="rounded-full p-2 hover:bg-white/15 disabled:opacity-30" aria-label="Previous month">‹</button>
        <p id="bk-month" class="w-44 text-center text-lg font-bold" aria-live="polite"></p>
        <button type="button" id="bk-next" class="rounded-full p-2 hover:bg-white/15 disabled:opacity-30" aria-label="Next month">›</button>
      </div>
      <div class="mt-4 grid grid-cols-7 gap-1 text-center text-xs font-bold uppercase tracking-wide text-brand-50">
        <span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span>
      </div>
      <div id="bk-days" class="mt-2 grid grid-cols-7 gap-1 text-center" role="grid"></div>
    </div>

    <div class="flex flex-col p-6 sm:p-8">
      <p class="text-sm font-semibold text-ink-900">Meeting</p>
      <p class="text-sm text-slate-600">Video call (<span id="bk-provider">Cisco Webex</span>) or phone · 30 minutes · Free</p>
      <label class="mt-5 block text-sm font-semibold text-ink-900">Your time zone
        <select id="bk-tz" class="field mt-1 text-sm">
          {zoneGroups.map(([group, list]) => (
            <optgroup label={group}>
              {list.map(([v, l]) => <option value={v} data-label={l}>{l}</option>)}
            </optgroup>
          ))}
        </select>
      </label>
      <p class="mt-6 text-sm font-semibold text-ink-900">What time works best?</p>
      <p id="bk-dayhead" class="text-sm text-slate-600">Loading available times…</p>
      <div id="bk-slots" class="mt-3 grid grid-cols-2 gap-2 lg:max-h-[340px] lg:overflow-y-auto lg:pr-1"></div>
    </div>
  </div>

  <!-- Step 2: details -->
  <form id="bk-step2" class="hidden p-6 sm:p-10" novalidate>
    <button type="button" id="bk-back" class="text-sm font-semibold text-brand-700 hover:underline">← Change time</button>
    <h2 class="mt-4 text-2xl font-extrabold">Confirm your consultation</h2>
    <p id="bk-chosen" class="mt-2 rounded-lg bg-brand-50 px-4 py-3 font-semibold text-brand-800"></p>
    <div class="mt-6 grid gap-5 sm:grid-cols-2">
      <label class="block text-sm font-medium text-ink-900">First name <span class="text-red-600">*</span><input name="first_name" required autocomplete="given-name" class="field" /></label>
      <label class="block text-sm font-medium text-ink-900">Last name <span class="text-red-600">*</span><input name="last_name" required autocomplete="family-name" class="field" /></label>
      <label class="block text-sm font-medium text-ink-900">Work email <span class="text-red-600">*</span><input name="email" type="email" required autocomplete="email" class="field" /></label>
      <label class="block text-sm font-medium text-ink-900">Phone<input name="phone" type="tel" autocomplete="tel" class="field" /></label>
      <label class="block text-sm font-medium text-ink-900 sm:col-span-2">Company<input name="company" autocomplete="organization" class="field" /></label>
      <label class="block text-sm font-medium text-ink-900 sm:col-span-2">What would you like to discuss?<textarea name="notes" rows="3" class="field"></textarea></label>
    </div>
    <div class="hidden" aria-hidden="true"><label>Website <input name="website" tabindex="-1" autocomplete="off" /></label></div>
    <label class="mt-5 flex gap-3 text-sm text-slate-600">
      <input type="checkbox" name="marketing_consent" value="yes" class="mt-0.5 h-4 w-4 shrink-0 accent-brand-600" />
      <span>Yes, send me occasional IT tips and news from FAJTech. You can unsubscribe at any time.</span>
    </label>
    <p class="mt-3 text-xs text-slate-500">You'll receive a calendar invitation by email. See our <a href="/privacy/" class="underline">privacy policy</a>.</p>
    <div id="bk-error" class="mt-4 hidden rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700" role="alert"></div>
    <button type="submit" class="btn-primary mt-6 w-full py-3.5 text-base sm:w-auto">Book my consultation</button>
  </form>

  <!-- Fallback when the calendar can't be reached -->
  <div id="bk-fallback" class="hidden p-6 sm:p-10">
    <h2 class="text-2xl font-extrabold">Choose your preferred time</h2>
    <p class="mt-2 mb-8 text-slate-600">Our live calendar is temporarily unavailable. Tell us when suits you and we'll confirm by email within one business day — or call <a href={`tel:${site.phone.replace(/[^+\d]/g, '')}`} class="font-semibold text-brand-700">{site.phone}</a>.</p>
    <ContactForm booking />
  </div>
</div>

<script>
  const API = '/api/booking.php';
  const $ = (id: string) => document.getElementById(id)!;
  const tzSel = $('bk-tz') as HTMLSelectElement;
  let slots: Date[] = [];
  let tz = Intl.DateTimeFormat().resolvedOptions().timeZone || 'America/Edmonton';
  // Show each zone's current local time, e.g. "Alberta — Calgary, Edmonton (9:15 am)".
  const now = new Date();
  for (const o of [...tzSel.options]) {
    try {
      const t = new Intl.DateTimeFormat('en-US', { timeZone: o.value, hour: 'numeric', minute: '2-digit' }).format(now).toLowerCase();
      o.textContent = `${o.dataset.label || o.textContent} (${t})`;
    } catch { /* unknown zone in an old browser: keep the plain label */ }
  }
  if (![...tzSel.options].some((o) => o.value === tz)) {
    let t = '';
    try { t = ' (' + new Intl.DateTimeFormat('en-US', { timeZone: tz, hour: 'numeric', minute: '2-digit' }).format(new Date()).toLowerCase() + ')'; } catch {}
    tzSel.insertBefore(new Option(`Detected — ${tz.split('/').pop()!.replace(/_/g, ' ')}${t}`, tz), tzSel.firstElementChild);
  }
  tzSel.value = tz;
  let view = new Date(); view.setDate(1);
  let selectedDay = '';
  let chosen: Date | null = null;

  const dayKey = (d: Date) => new Intl.DateTimeFormat('en-CA', { timeZone: tz, year: 'numeric', month: '2-digit', day: '2-digit' }).format(d);
  const fmtTime = (d: Date) => new Intl.DateTimeFormat('en-US', { timeZone: tz, hour: 'numeric', minute: '2-digit' }).format(d).toLowerCase();
  const fmtLong = (d: Date) => new Intl.DateTimeFormat('en-US', { timeZone: tz, weekday: 'long', month: 'long', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit', timeZoneName: 'short' }).format(d);
  const byDay = () => { const m = new Map<string, Date[]>(); for (const s of slots) { const k = dayKey(s); m.set(k, [...(m.get(k) || []), s]); } return m; };

  function fallback() { $('bk-step1').classList.add('hidden'); $('bk-step2').classList.add('hidden'); $('bk-fallback').classList.remove('hidden'); }

  function renderCalendar() {
    const days = byDay();
    $('bk-month').textContent = view.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
    const grid = $('bk-days'); grid.innerHTML = '';
    const first = new Date(view.getFullYear(), view.getMonth(), 1).getDay();
    const total = new Date(view.getFullYear(), view.getMonth() + 1, 0).getDate();
    for (let i = 0; i < first; i++) grid.appendChild(document.createElement('span'));
    for (let d = 1; d <= total; d++) {
      const key = `${view.getFullYear()}-${String(view.getMonth() + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
      const avail = days.has(key);
      const b = document.createElement('button');
      b.type = 'button'; b.textContent = String(d);
      b.className = 'mx-auto flex h-10 w-10 items-center justify-center rounded-full text-sm font-semibold transition ' +
        (key === selectedDay ? 'bg-white text-brand-700' : avail ? 'text-white hover:bg-white/20 ring-1 ring-white/40' : 'text-white/35 cursor-default');
      b.disabled = !avail;
      b.setAttribute('aria-label', `${key}${avail ? ', times available' : ', unavailable'}`);
      b.addEventListener('click', () => {
        selectedDay = key; renderCalendar(); renderSlots();
        // On phones the times are below the calendar: bring them into view.
        if (window.matchMedia('(max-width: 1023px)').matches) $('bk-dayhead').scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
      grid.appendChild(b);
    }
    const keys = [...days.keys()].sort();
    const ym = (k: string) => k.slice(0, 7);
    const cur = `${view.getFullYear()}-${String(view.getMonth() + 1).padStart(2, '0')}`;
    ($('bk-prev') as HTMLButtonElement).disabled = !keys.some((k) => ym(k) < cur);
    ($('bk-next') as HTMLButtonElement).disabled = !keys.some((k) => ym(k) > cur);
  }

  function renderSlots() {
    const list = $('bk-slots'); list.innerHTML = '';
    const day = byDay().get(selectedDay) || [];
    if (!selectedDay || !day.length) { $('bk-dayhead').textContent = slots.length ? 'Select a highlighted day.' : 'No times available in the next few weeks — please call or WhatsApp us.'; return; }
    const [y, m, d] = selectedDay.split('-').map(Number);
    $('bk-dayhead').innerHTML = `Showing times for <strong>${new Date(y, m - 1, d).toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' })}</strong>`;
    for (const s of day) {
      const b = document.createElement('button');
      b.type = 'button'; b.textContent = fmtTime(s);
      b.className = 'rounded-lg border border-brand-300 py-2.5 text-sm font-semibold text-brand-700 transition hover:border-brand-600 hover:bg-brand-50';
      b.addEventListener('click', () => { chosen = s; $('bk-chosen').textContent = fmtLong(s); $('bk-step1').classList.add('hidden'); $('bk-step2').classList.remove('hidden'); $('bk').scrollIntoView({ behavior: 'smooth', block: 'start' }); });
      list.appendChild(b);
    }
  }

  async function load() {
    try {
      const r = await fetch(`${API}?action=slots`, { headers: { Accept: 'application/json' } });
      const j = await r.json();
      if (!r.ok || !j.ok) return fallback();
      if (j.consultant) $('bk-consultant').textContent = j.consultant;
      if (j.provider) $('bk-provider').textContent = j.provider;
      slots = j.slots.map((s: string) => new Date(s));
      const first = slots[0];
      if (first) { selectedDay = dayKey(first); const [y, m] = selectedDay.split('-').map(Number); view = new Date(y, m - 1, 1); }
      renderCalendar(); renderSlots();
    } catch { fallback(); }
  }

  $('bk-prev').addEventListener('click', () => { view = new Date(view.getFullYear(), view.getMonth() - 1, 1); renderCalendar(); });
  $('bk-next').addEventListener('click', () => { view = new Date(view.getFullYear(), view.getMonth() + 1, 1); renderCalendar(); });
  tzSel.addEventListener('change', () => { tz = tzSel.value; selectedDay = slots[0] ? dayKey(slots[0]) : ''; renderCalendar(); renderSlots(); });
  $('bk-back').addEventListener('click', () => { $('bk-step2').classList.add('hidden'); $('bk-step1').classList.remove('hidden'); });

  const form = $('bk-step2') as HTMLFormElement;
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const err = $('bk-error'); err.classList.add('hidden');
    if (!form.checkValidity()) { form.reportValidity(); return; }
    if (!chosen) return;
    const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
    btn.disabled = true; btn.textContent = 'Booking…';
    const fd = new FormData(form);
    fd.set('action', 'book'); fd.set('slot', chosen.toISOString().replace(/\.\d{3}Z$/, 'Z')); fd.set('tz', tz);
    try { const g = localStorage.getItem('faj_gclid'); if (g) fd.set('gclid', g); } catch {}
    try {
      const r = await fetch(API, { method: 'POST', body: fd, headers: { Accept: 'application/json' } });
      const j = await r.json().catch(() => ({}));
      if (r.ok && j.ok) { (window.top || window).location.href = '/thank-you/?source=booking'; return; }
      if (j.refresh) { await load(); $('bk-step2').classList.add('hidden'); $('bk-step1').classList.remove('hidden'); }
      if (j.fallback) return fallback();
      throw new Error(j.error || 'Something went wrong.');
    } catch (ex) {
      err.textContent = (ex as Error).message; err.classList.remove('hidden');
      btn.disabled = false; btn.textContent = 'Book my consultation';
    }
  });

  load();
</script>
