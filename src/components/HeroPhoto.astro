---
/**
 * Background photo for a page header (GAM Tech-style: photo + dark overlay + curved bottom).
 * Looks for the first existing file among `keys` in src/assets/headers/ (jpg/jpeg/png/webp),
 * then falls back to "default". Renders nothing when no photo exists, so headers keep the plain design.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { headerAlt } from '../data/headerPhotos';

interface Props { keys: string[]; curve?: boolean; strength?: 'normal' | 'strong' }
const { keys, curve = true, strength = 'normal' } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/headers/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}', { eager: true });
const byName = new Map(Object.entries(files).map(([p, m]) => [p.split('/').pop()!.replace(/\.[^.]+$/, '').toLowerCase(), m.default]));
const key = [...keys, 'default'].map((k) => k.toLowerCase()).find((k) => byName.has(k));
const img = key ? byName.get(key)! : null;
---
{img && (
  <>
    <Image
      src={img}
      alt={headerAlt(key!)}
      widths={[640, 960, 1280, 1920]}
      sizes="100vw"
      format="webp"
      quality={70}
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div
      class:list={[
        'absolute inset-0',
        strength === 'strong'
          ? 'bg-gradient-to-r from-ink-950/95 via-ink-950/85 to-ink-950/60'
          : 'bg-gradient-to-r from-ink-950/90 via-ink-950/70 to-ink-950/30',
      ]}
      aria-hidden="true"
    ></div>
    {curve && (
      <svg class="absolute bottom-0 left-0 block h-10 w-full text-white sm:h-16" viewBox="0 0 1440 100" preserveAspectRatio="none" aria-hidden="true">
        <path fill="currentColor" d="M0,60 C360,110 720,0 1080,30 C1260,45 1380,70 1440,60 L1440,100 L0,100 Z" />
      </svg>
    )}
  </>
)}
