---
import Icon from './Icon.astro';
interface Props { items: { q: string; a: string }[]; title?: string }
const { items, title = 'Frequently asked questions' } = Astro.props;
---
<section class="section bg-slate-50" aria-labelledby="faq-title">
  <div class="container-x grid gap-10 lg:grid-cols-[1fr_2fr]">
    <div>
      <p class="eyebrow">FAQ</p>
      <h2 id="faq-title" class="mt-3 text-3xl font-extrabold sm:text-4xl">{title}</h2>
      <p class="mt-4 text-slate-600">Can't find your answer? <a href="/contact/" class="font-semibold text-brand-600 hover:underline">Ask us directly</a>.</p>
    </div>
    <div class="divide-y divide-slate-200 rounded-2xl border border-slate-200 bg-white">
      {items.map((f) => (
        <details class="group p-5 sm:p-6">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-ink-900 [&::-webkit-details-marker]:hidden">
            {f.q}
            <Icon name="chevron" class="h-5 w-5 shrink-0 text-brand-600 transition group-open:rotate-180" />
          </summary>
          <p class="mt-3 leading-relaxed text-slate-600">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
