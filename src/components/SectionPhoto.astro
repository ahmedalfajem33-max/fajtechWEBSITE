---
/**
 * In-page photo for content sections: rounded photo with a soft shadow, an offset brand-colour
 * accent behind it and an optional floating badge.
 * Looks for the first existing file among `keys` in src/assets/photos/ (jpg/jpeg/png/webp).
 * Renders nothing when no photo exists, so sections keep working without one.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';

interface Props {
  keys: string[];
  alt: string;
  /** Which side the accent block sticks out on. */
  accent?: 'left' | 'right';
  badge?: { title: string; text?: string; icon?: string };
  class?: string;
}
const { keys, alt, accent = 'right', badge, class: className } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/photos/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}', { eager: true });
const byName = new Map(Object.entries(files).map(([p, m]) => [p.split('/').pop()!.replace(/\.[^.]+$/, '').toLowerCase(), m.default]));
const key = keys.map((k) => k.toLowerCase()).find((k) => byName.has(k));
const img = key ? byName.get(key)! : null;
---
{img && (
  <figure class:list={['relative', badge && 'mb-8', className]}>
    <div
      class:list={[
        'absolute inset-0 translate-y-3 rounded-3xl bg-gradient-to-br from-brand-100 to-brand-200/70 sm:translate-y-5',
        accent === 'right' ? 'translate-x-3 sm:translate-x-5' : '-translate-x-3 sm:-translate-x-5',
      ]}
      aria-hidden="true"
    ></div>
    <div
      class:list={[
        'dots absolute -top-5 hidden h-24 w-24 opacity-60 sm:block',
        accent === 'right' ? '-left-5' : '-right-5',
      ]}
      aria-hidden="true"
    ></div>
    <Image
      src={img}
      alt={alt}
      widths={[480, 720, 960, 1280]}
      sizes="(min-width: 1024px) 600px, 100vw"
      format="webp"
      quality={72}
      loading="lazy"
      class="relative aspect-[4/3] w-full rounded-2xl object-cover shadow-2xl shadow-ink-900/15"
    />
    {badge && (
      <figcaption
        class:list={[
          'absolute -bottom-8 flex max-w-[80%] items-center gap-3 rounded-xl bg-white p-4 shadow-xl ring-1 ring-slate-200',
          accent === 'right' ? 'left-4 sm:left-6' : 'right-4 sm:right-6',
        ]}
      >
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand-600 text-white"><Icon name={badge.icon ?? 'check'} class="h-5 w-5" /></span>
        <span>
          <span class="block font-bold leading-tight text-ink-900">{badge.title}</span>
          {badge.text && <span class="mt-0.5 block text-sm text-slate-600">{badge.text}</span>}
        </span>
      </figcaption>
    )}
  </figure>
)}

<style>
  .dots {
    background-image: radial-gradient(var(--color-brand-400) 1.5px, transparent 1.5px);
    background-size: 12px 12px;
  }
</style>
