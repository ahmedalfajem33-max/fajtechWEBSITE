---
/**
 * Full-width rounded photo banner with a navy fade on the left for text.
 * Uses the first existing file among `keys` in src/assets/photos/; renders nothing when none exists.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props { keys: string[]; alt: string; eyebrow?: string; title: string; text?: string }
const { keys, alt, eyebrow, title, text } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/photos/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}', { eager: true });
const byName = new Map(Object.entries(files).map(([p, m]) => [p.split('/').pop()!.replace(/\.[^.]+$/, '').toLowerCase(), m.default]));
const key = keys.map((k) => k.toLowerCase()).find((k) => byName.has(k));
const img = key ? byName.get(key)! : null;
---
{img && (
  <div class="relative isolate flex min-h-[380px] overflow-hidden rounded-3xl bg-ink-900 shadow-2xl shadow-ink-900/15 sm:min-h-[440px]">
    <Image
      src={img}
      alt={alt}
      widths={[640, 960, 1280, 1600]}
      sizes="(min-width: 1280px) 1200px, 100vw"
      format="webp"
      quality={72}
      loading="lazy"
      class="absolute inset-0 -z-10 h-full w-full object-cover object-[70%_center]"
    />
    <div class="absolute inset-0 -z-10 bg-gradient-to-t from-ink-950/90 via-ink-950/50 to-ink-950/10 md:bg-gradient-to-r md:from-ink-950/90 md:via-ink-950/55 md:to-transparent" aria-hidden="true"></div>
    <div class="flex max-w-xl flex-col justify-end p-8 sm:p-12 md:justify-center">
      {eyebrow && <p class="eyebrow text-brand-300">{eyebrow}</p>}
      <h2 class="mt-3 text-2xl font-extrabold text-white sm:text-3xl">{title}</h2>
      {text && <p class="mt-4 text-slate-200">{text}</p>}
      <slot />
    </div>
  </div>
)}
