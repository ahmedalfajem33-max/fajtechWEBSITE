---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, googleAds, zoho } from '../config/site';

interface Props {
  title: string;
  description: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}
const { title, description, schema, noindex = false } = Astro.props;
const fullTitle = title.includes(site.name) ? title : `${title} | ${site.name}`;
const canonical = new URL(Astro.url.pathname, site.url).href;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${site.url}/#business`,
  name: site.name,
  url: site.url,
  email: site.email,
  ...(site.phone ? { telephone: site.phone } : {}),
  description: 'Managed IT services, cybersecurity and cloud solutions for Canadian businesses.',
  image: `${site.url}/og-image.png`,
  logo: `${site.url}/favicon-192x192.png`,
  areaServed: [{ '@type': 'City', name: 'Calgary' }, { '@type': 'Country', name: 'Canada' }],
  contactPoint: [
    { '@type': 'ContactPoint', contactType: 'technical support', telephone: site.phone, areaServed: 'CA', availableLanguage: ['English'] },
    { '@type': 'ContactPoint', contactType: 'technical support', telephone: site.afterHours.phone, description: 'WhatsApp 24/7; phone calls after hours (6 pm – 8 am Mountain Time)', availableLanguage: ['English', 'Arabic'] },
  ],
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    opens: '00:00',
    closes: '23:59',
  }],
  address: {
    '@type': 'PostalAddress',
    ...(site.showStreetAddress ? { streetAddress: site.address.street } : {}),
    addressLocality: site.address.city,
    ...(site.address.postalCode ? { postalCode: site.address.postalCode } : {}),
    addressRegion: site.address.region,
    addressCountry: site.address.country,
  },
};
const schemas = [orgSchema, ...(schema ? (Array.isArray(schema) ? schema : [schema]) : [])];

// Data passed to the client-side tracking helper.
const tracking = { adsId: googleAds.id, conversions: googleAds.conversions };
---
<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#111c2a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon-192x192.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site.url}/og-image.png`} />
    <meta property="og:locale" content="en_CA" />
    <meta name="twitter:card" content="summary_large_image" />


    <!-- Google Ads tag (kept from the previous fajtech.ca site) -->
    <!-- Events queue in dataLayer immediately; the gtag library loads once the page has rendered (faster first paint). -->
    <script is:inline define:vars={{ adsId: googleAds.id, ga4Id: googleAds.ga4Id }}>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { dataLayer.push(arguments); };
      gtag('js', new Date());
      gtag('config', adsId);
      if (ga4Id) gtag('config', ga4Id);
      window.addEventListener('load', function () {
        setTimeout(function () {
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + adsId;
          document.head.appendChild(s);
        }, 1500);
      });
    </script>

    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body class="flex min-h-screen flex-col pb-16 lg:pb-0">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-lg focus:bg-white focus:px-4 focus:py-2 focus:shadow-lg">Skip to content</a>
    <Header />
    <main id="main" class="flex-1"><slot /></main>
    <Footer />
    <!-- "Book a consultation" pop-up: opens the booking calendar instantly from any Book button -->
    <dialog id="book-modal" aria-label="Book a free IT consultation"
      class="m-0 h-[100dvh] max-h-none w-full max-w-none bg-transparent p-0 backdrop:bg-ink-950/70 backdrop:backdrop-blur-sm sm:m-auto sm:h-auto sm:max-h-[94vh] sm:w-[min(1080px,94vw)]">
      <div class="flex h-full flex-col overflow-hidden bg-white sm:h-auto sm:max-h-[94vh] sm:rounded-2xl sm:shadow-2xl">
        <div class="flex items-center justify-between border-b border-slate-200 bg-ink-900 px-4 py-3 text-white sm:px-6">
          <p class="font-bold">Book a free IT consultation <span class="hidden font-normal text-slate-300 sm:inline">· 30 min · no obligation</span></p>
          <button type="button" id="book-modal-close" class="rounded-lg p-2 hover:bg-white/10" aria-label="Close">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12"/></svg>
          </button>
        </div>
        <iframe id="book-modal-frame" title="Booking calendar" class="w-full flex-1 border-0 sm:h-[640px] sm:flex-none"></iframe>
      </div>
    </dialog>
    <script is:inline>
      (function () {
        var dlg = document.getElementById('book-modal');
        if (!dlg || typeof dlg.showModal !== 'function') return; // very old browsers: links just open the booking page
        var frame = document.getElementById('book-modal-frame');
        var path = location.pathname.replace(/\/+$/, '');
        if (path === '/book-a-consultation' || path === '/book-embed') return;
        function open() {
          if (!frame.getAttribute('src')) frame.setAttribute('src', '/book-embed/');
          dlg.showModal();
          document.documentElement.style.overflow = 'hidden';
          if (typeof gtag === 'function') gtag('event', 'booking_open');
        }
        function close() { dlg.close(); }
        // Fit the pop-up to the calendar's height on larger screens.
        window.addEventListener('message', function (e) {
          if (e.origin !== location.origin || !e.data || !e.data.fajBookHeight) return;
          if (window.matchMedia('(min-width: 640px)').matches) {
            frame.style.height = Math.min(e.data.fajBookHeight, window.innerHeight * 0.94 - 56) + 'px';
          }
        });
        dlg.addEventListener('close', function () { document.documentElement.style.overflow = ''; });
        document.getElementById('book-modal-close').addEventListener('click', close);
        dlg.addEventListener('click', function (e) { if (e.target === dlg) close(); }); // click outside
        document.addEventListener('click', function (e) {
          if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          var a = e.target.closest && e.target.closest('a[href]');
          if (!a) return;
          var u = new URL(a.href, location.href);
          if (u.origin !== location.origin || u.pathname.replace(/\/+$/, '') !== '/book-a-consultation') return;
          e.preventDefault();
          var mm = document.getElementById('mobile-menu'); if (mm) mm.classList.add('hidden');
          open();
        });
      })();
    </script>

    <!-- Floating WhatsApp button (24/7) -->
    <a href={site.afterHours.whatsapp} target="_blank" rel="noopener" aria-label="WhatsApp FAJTech support, available 24/7"
      class="group fixed right-4 bottom-20 z-40 flex items-center gap-2 rounded-full bg-[#25D366] p-3.5 text-white shadow-xl shadow-green-600/30 transition hover:bg-[#1ebe5b] lg:right-6 lg:bottom-6">
      <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21l1.6-4.7A8.5 8.5 0 1 1 7.7 19.4L3 21z"/><path d="M9 8.5c0 3.6 2.9 6.5 6.5 6.5l1-1.6-2-1-1 1a4 4 0 0 1-2.4-2.4l1-1-1-2L9 8.5z"/></svg>
      <span class="hidden pr-1 text-sm font-semibold lg:group-hover:inline">WhatsApp 24/7</span>
    </a>
    <!-- Sticky call / book bar on phones -->
    <div class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 gap-2 border-t border-slate-200 bg-white/95 p-2 shadow-[0_-4px_20px_rgba(0,0,0,0.08)] backdrop-blur lg:hidden">
      <a id="call-now" href={`tel:${site.phone.replace(/[^+\d]/g, '')}`} data-night={`tel:${site.afterHours.phone.replace(/[^+\d]/g, '')}`} class="btn-outline py-2.5"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>Call 24/7</a>
      <a href="/book-a-consultation/" class="btn-primary py-2.5">Book a consultation</a>
    </div>
    <script is:inline>
      // The sticky Call button dials the team on shift: Calgary 8 am-6 pm, night team otherwise (Calgary time).
      (function () {
        var a = document.getElementById('call-now'); if (!a) return;
        var h = Number(new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Edmonton', hour: 'numeric', hourCycle: 'h23' }).format(new Date()));
        if (h < 8 || h >= 18) a.href = a.getAttribute('data-night');
      })();
    </script>

    <!-- Conversion tracking: phone & email clicks, and a helper for the contact form -->
    <script is:inline define:vars={{ tracking }}>
      window.fajTrack = function (key, extra) {
        if (typeof gtag !== 'function') return;
        var label = tracking.conversions[key];
        if (label) gtag('event', 'conversion', Object.assign({ send_to: label }, extra || {}));
        gtag('event', key, extra || {});
      };
      document.addEventListener('click', function (e) {
        var a = e.target.closest && e.target.closest('a[href^="tel:"], a[href^="mailto:"]');
        if (!a) return;
        window.fajTrack(a.href.indexOf('tel:') === 0 ? 'phoneClick' : 'emailClick');
      });
    </script>

    {zoho.salesIqWidgetCode && (
      <script is:inline define:vars={{ code: zoho.salesIqWidgetCode, region: zoho.salesIqRegion }}>
        window.$zoho = window.$zoho || {};
        $zoho.salesiq = $zoho.salesiq || { ready: function () {} };
        var s = document.createElement('script');
        s.id = 'zsiqscript';
        s.defer = true;
        s.src = 'https://salesiq.zohopublic.' + region + '/widget?wc=' + code;
        document.body.appendChild(s);
      </script>
    )}
  </body>
</html>
